<?xml version="1.0" encoding="utf-8"?>
<!-- widget_edit_notes.xml used by CountOptionsActivity.kt
     Last edited on 2026-08-14
  -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginLeft="5dp"
              android:layout_marginTop="5dp"
              android:layout_marginRight="5dp"
              android:paddingStart="5dp"
              android:paddingEnd="5dp"
              android:paddingBottom="5dp"
              android:background="@drawable/rounded_corner">

        <TextView
			style="@style/HeadlineText"
            android:id="@+id/widgetNotesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:hint="@string/hintTitle"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            android:gravity="start|top"/>

        <AutoCompleteTextView
            style="@style/BoldText"
            android:id="@+id/sNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/count_background"
            android:inputType="textCapSentences"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:completionThreshold="0"
            android:popupBackground="@color/Navy"
            android:hint="@string/notesHint" />

</LinearLayout>
