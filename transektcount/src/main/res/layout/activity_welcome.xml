<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/baseLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".WelcomeActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0sp"
        android:layout_gravity="center"
        android:layout_marginTop="30sp"
        android:layout_weight="4"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="70sp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginEnd="10sp"
            android:src="@mipmap/ic_launcher_round"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:gravity="center_vertical"
            android:textColor="@android:color/white"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/welcomeWaffle"
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_margin="10sp"
        android:layout_weight="5"
        android:gravity="center_horizontal"
        android:padding="10sp"
        android:text="@string/title"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0sp"
        android:layout_weight="14" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0sp"
        android:layout_gravity="center"
        android:layout_marginBottom="9sp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/editMetaButton"
            android:layout_width="50sp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:onClick="editMeta"
            android:src="@android:drawable/ic_menu_edit"
            tools:ignore="ContentDescription,UsingOnClickInXml" />

        <TextView
            android:id="@+id/editMetaButtonText"
            android:layout_width="200sp"
            android:layout_height="30sp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="15sp"
            android:backgroundTint="#333333"
            android:onClick="editMeta"
            android:text="@string/editMetaButton"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="UsingOnClickInXml" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0sp"
        android:layout_gravity="center"
        android:layout_marginBottom="9sp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/viewSectionButton"
            android:layout_width="50sp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:onClick="selectSection"
            android:src="@drawable/ic_count_white"
            tools:ignore="ContentDescription,UsingOnClickInXml" />

        <TextView
            android:id="@+id/viewSectionButtonText"
            android:layout_width="200sp"
            android:layout_height="30sp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="15sp"
            android:backgroundTint="#333333"
            android:onClick="selectSection"
            android:text="@string/viewSectionButton"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="UsingOnClickInXml" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/viewSpec"
        android:layout_width="wrap_content"
        android:layout_height="0sp"
        android:layout_gravity="center"
        android:layout_marginBottom="20sp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/showResultsButton"
            android:layout_width="50sp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:onClick="showResults"
            android:src="@android:drawable/ic_menu_view"
            tools:ignore="ContentDescription,UsingOnClickInXml" />

        <TextView
            android:id="@+id/showResultsButtonText"
            android:layout_width="200sp"
            android:layout_height="30sp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="15sp"
            android:backgroundTint="#333333"
            android:onClick="showResults"
            android:text="@string/showResultsButton"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="UsingOnClickInXml" />
    </LinearLayout>

</LinearLayout>
